---
import { salon, whatsappHref } from "../data/site";
import SocialLinks from "./SocialLinks.astro";
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <a href="/" class="footer-logo" aria-label={salon.name}>
        <img src="/logo-tufano.png" alt="" width="442" height="89" />
      </a>
      <p>Parrucchiere ed estetica a Milano dal 1982.</p>
      <SocialLinks />
    </div>
    <div>
      <p class="label">Salone</p>
      <address>
        {salon.street}<br />
        {salon.postalCode} {salon.city}<br />
        Mar–Ven 9:00–19:00<br />
        Sab 8:30–18:00 · Lunedì chiuso
      </address>
    </div>
    <div>
      <p class="label">Contatti</p>
      <nav class="footer-links" aria-label="Contatti">
        <a href={`tel:${salon.phoneTel}`}>{salon.phoneDisplay}</a>
        <a href={whatsappHref} target="_blank" rel="noopener">WhatsApp {salon.whatsappDisplay}</a>
        <a href={`mailto:${salon.email}`}>{salon.email}</a>
      </nav>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} {salon.name}</span>
    <span>Milano</span>
  </div>
</footer>

<style>
  .site-footer {
    background: #141414;
    color: #f7f4ef;
    padding: 72px 6vw 28px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 40px;
    max-width: 1120px;
    margin: 0 auto 40px;
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: 14px;
    line-height: 0;
    text-decoration: none;
  }

  .footer-logo img {
    display: block;
    height: 30px;
    width: auto;
    filter: invert(1);
  }

  .site-footer p,
  address {
    margin: 0 0 18px;
    font-style: normal;
    line-height: 1.7;
    color: rgba(247, 244, 239, 0.78);
  }

  .site-footer :global(.social) {
    color: #f7f4ef;
  }

  .label {
    margin-bottom: 12px !important;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c4a574 !important;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-links a {
    color: rgba(247, 244, 239, 0.78);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: #fff;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    max-width: 1120px;
    margin: 0 auto;
    padding-top: 20px;
    border-top: 1px solid rgba(247, 244, 239, 0.12);
    font-size: 13px;
    color: rgba(247, 244, 239, 0.5);
  }

  @media (max-width: 800px) {
    .footer-grid,
    .footer-bottom {
      grid-template-columns: 1fr;
      flex-direction: column;
    }
  }
</style>
