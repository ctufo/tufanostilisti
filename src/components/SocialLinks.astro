---
import { salon } from "../data/site";
---

<nav class="social" aria-label="Social">
  <a href={salon.facebook} target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="currentColor"
        d="M14.2 8.2h-1.7c-.4 0-.7.3-.7.8v1.5h2.5l-.4 2.4h-2.1V20h-2.5v-7.1H7.5V10.5h1.8V8.6A3.3 3.3 0 0 1 12.7 5h1.5v3.2z"
      ></path>
    </svg>
    <span>Facebook</span>
  </a>
  <a href={salon.instagram} target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="currentColor"
        d="M8 3.5h8A4.5 4.5 0 0 1 20.5 8v8a4.5 4.5 0 0 1-4.5 4.5H8A4.5 4.5 0 0 1 3.5 16V8A4.5 4.5 0 0 1 8 3.5zm8 1.6H8A2.9 2.9 0 0 0 5.1 8v8A2.9 2.9 0 0 0 8 18.9h8A2.9 2.9 0 0 0 18.9 16V8A2.9 2.9 0 0 0 16 5.1zM12 8.2A3.8 3.8 0 1 1 8.2 12 3.8 3.8 0 0 1 12 8.2zm0 1.6A2.2 2.2 0 1 0 14.2 12 2.2 2.2 0 0 0 12 9.8zm4.35-2.85a1 1 0 1 1-1 1 1 1 0 0 1 1-1z"
      ></path>
    </svg>
    <span>Instagram</span>
  </a>
</nav>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .social svg {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .social a:hover {
    color: #c4a574;
  }
</style>
