---
import Layout from "../layouts/Layout.astro";

const story = [
  {
    year: "1958 / 1960",
    text: "Nascono Bruno e Dario, nella storica città di Teano.",
  },
  {
    year: "1970",
    text: "Sin da bambini, a 10 e 12 anni, iniziano a lavorare e ad appassionarsi all’hairstyling.",
  },
  {
    year: "1974",
    text: "Arrivati a Milano ancora giovanissimi, iniziano a lavorare per due grandi saloni milanesi.",
  },
  {
    year: "1982",
    text: "Dopo varie esperienze nel settore, i fratelli Tufano aprono il primo salone di parrucchieri a Milano.",
  },
  {
    year: "Anni ’80",
    text: "Collaborano con grandi marchi e partecipano a eventi di moda, portando in giro il loro punto di vista.",
  },
  {
    year: "1990",
    text: "Aprono un salone più grande in piazzale Susa, a Milano, dove ancora oggi ricevono la clientela.",
  },
];

const values = [
  {
    title: "Soddisfazione del cliente",
    text: "Ogni appuntamento parte da chi entra in salone. Il risultato conta se la persona esce contenta.",
  },
  {
    title: "Qualità",
    text: "Tecniche, prodotti e attenzione al dettaglio, scelti per durare oltre la giornata in salone.",
  },
  {
    title: "Passione",
    text: "Una famiglia che lavora da anni nello stesso mestiere, con la stessa voglia di farlo bene.",
  },
];
---

<Layout
  title="Chi siamo | Tufano Stilisti – Parrucchiere Milano dal 1982"
  description="Tufano Stilisti nasce nel 1982 da Bruno e Dario. La storia del salone di parrucchieri ed estetica a Milano."
  path="/chi-siamo"
  ogImage="/images/servizio-donna.jpg"
  active="chi-siamo"
>
  <main>
    <section class="intro">
      <div>
        <p class="kicker">Chi siamo</p>
        <h1>Una famiglia, dal 1982</h1>
        <p>
          Tufano Stilisti nasce circa quarant’anni fa, nel 1982, da Bruno e Dario, due fratelli accomunati da un talento per l’hairstyling.
        </p>
        <p>
          Non siamo un semplice salone. Siamo una famiglia che da anni lavora in questo mestiere con una grande passione.
        </p>
        <p>
          I nostri valori sono la qualità, la passione, l’innovazione e, soprattutto, la soddisfazione di ciascun cliente.
        </p>
      </div>
      <img src="/images/servizio-donna.jpg" alt="Lavoro sui capelli da Tufano Stilisti a Milano" />
    </section>

    <section class="story">
      <div class="story-head">
        <p class="kicker">La nostra storia</p>
        <h2>A Milano</h2>
      </div>
      <ol>
        {
          story.map((item) => (
            <li data-reveal>
              <span>{item.year}</span>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="values">
      <div class="values-copy" data-reveal>
        <p class="kicker light">I nostri valori</p>
        <h2>Come lavoriamo</h2>
        <p>
          Siamo fieri della storia del salone, e ancora di più dei valori con cui raccontiamo chi siamo e come lavoriamo davvero.
        </p>
      </div>
      <div class="values-grid">
        {
          values.map((item) => (
            <article data-reveal>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 56px;
    align-items: center;
    max-width: 1180px;
    margin: 0 auto;
    padding: 72px 6vw 40px;
  }

  h1,
  .story h2,
  .values h2 {
    font-size: clamp(48px, 6vw, 80px);
    line-height: 0.95;
  }

  .intro h1 {
    margin-bottom: 18px;
  }

  .intro p {
    max-width: 520px;
    margin: 0 0 16px;
    line-height: 1.7;
    color: #3d3832;
  }

  .intro .kicker {
    margin-bottom: 14px;
  }

  .intro img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .story {
    max-width: 980px;
    margin: 0 auto;
    padding: 48px 6vw 20px;
  }

  .story-head {
    margin-bottom: 12px;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    padding: 26px 0;
    border-top: 1px solid rgba(20, 20, 20, 0.12);
  }

  li:last-child {
    border-bottom: 1px solid rgba(20, 20, 20, 0.12);
  }

  li span {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8c7355;
  }

  li p {
    margin: 0;
    line-height: 1.65;
    color: #3d3832;
  }

  .values {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 48px;
    margin-top: 28px;
    padding: 80px 6vw 100px;
    background: #141414;
    color: #f7f4ef;
  }

  .kicker.light {
    color: #c4a574;
  }

  .values-copy p:last-child {
    max-width: 380px;
    margin: 16px 0 0;
    line-height: 1.7;
    color: rgba(247, 244, 239, 0.75);
  }

  .values-grid {
    display: grid;
    gap: 0;
  }

  .values article {
    padding: 22px 0;
    border-top: 1px solid rgba(247, 244, 239, 0.16);
  }

  .values article:last-child {
    border-bottom: 1px solid rgba(247, 244, 239, 0.16);
  }

  h3 {
    font-size: clamp(28px, 3vw, 36px);
    margin-bottom: 8px;
  }

  .values article p {
    margin: 0;
    max-width: 460px;
    line-height: 1.65;
    color: rgba(247, 244, 239, 0.75);
  }

  @media (max-width: 800px) {
    .intro,
    .values,
    li {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .intro {
      padding-top: 48px;
    }

    .values {
      padding-bottom: 72px;
    }
  }
</style>
