---
import Layout from "../layouts/Layout.astro";
import { whatsappHref } from "../data/site";

const services = [
  {
    title: "Taglio",
    text: "Classico e sempre in ordine, oppure l’ultimo taglio di tendenza. Si parte dalla tua richiesta.",
  },
  {
    title: "Barba",
    text: "Regolazione, taglio o cura di una barba folta, con prodotti e strumenti adatti.",
  },
  {
    title: "Colore",
    text: "Tinte naturali e di ultima generazione, per arrivare al tono che cerchi.",
  },
  {
    title: "Permanente e stiratura",
    text: "Il riccio che vuoi tenere, oppure un liscio che dura mesi su capelli folti e crespi.",
  },
];
---

<Layout
  title="Uomo | Tufano Stilisti – Parrucchiere Milano"
  description="Taglio uomo, barba e colore da Tufano Stilisti a Milano, in Via Giovanni da Milano 1."
  path="/uomo"
  ogImage="/images/servizio-uomo.jpg"
  active="uomo"
>
  <main>
    <section class="intro">
      <div>
        <p class="kicker">Uomo</p>
        <h1>Taglio preciso, barba curata</h1>
        <p>
          Un taglio tradizionale o un hairstyling di tendenza. In salone c’è anche la consulenza, se vuoi cambiare senza indovinare.
        </p>
        <a href={whatsappHref} class="btn" target="_blank" rel="noopener">Prenota</a>
      </div>
      <img src="/images/servizio-uomo.jpg" alt="Taglio uomo da Tufano Stilisti" />
    </section>

    <section class="list">
      {
        services.map((item, index) => (
          <article data-reveal>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </section>
  </main>
</Layout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 48px;
    align-items: center;
    max-width: 1180px;
    margin: 0 auto;
    padding: 72px 6vw 40px;
  }

  h1 {
    font-size: clamp(48px, 6vw, 80px);
    line-height: 0.95;
    margin-bottom: 16px;
  }

  .intro p:last-of-type {
    max-width: 460px;
    margin: 0 0 24px;
    line-height: 1.7;
    color: #3d3832;
  }

  .intro img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .list {
    max-width: 980px;
    margin: 0 auto;
    padding: 24px 6vw 100px;
  }

  article {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 16px;
    padding: 28px 0;
    border-top: 1px solid rgba(20, 20, 20, 0.12);
  }

  article:last-child {
    border-bottom: 1px solid rgba(20, 20, 20, 0.12);
  }

  article span {
    font-size: 13px;
    letter-spacing: 0.14em;
    color: #8c7355;
  }

  h2 {
    font-size: clamp(28px, 3vw, 40px);
    margin-bottom: 8px;
  }

  article p {
    margin: 0;
    max-width: 560px;
    line-height: 1.65;
    color: #3d3832;
  }

  @media (max-width: 800px) {
    .intro {
      grid-template-columns: 1fr;
      padding-top: 48px;
    }

    article {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
