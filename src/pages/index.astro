---
import Layout from "../layouts/Layout.astro";
import Hours from "../components/Hours.astro";

const description =
  "Tufano Stilisti, parrucchiere ed estetica a Milano dal 1982. Taglio, colore, sposa e trattamenti in Via Giovanni da Milano 1.";

const pillars = [
  {
    href: "/donna",
    image: "/images/servizio-donna.jpg",
    title: "Donna",
    text: "Taglio, colore, balayage ed extension.",
  },
  {
    href: "/uomo",
    image: "/images/servizio-uomo.jpg",
    title: "Uomo",
    text: "Taglio, barba e hairstyling.",
  },
  {
    href: "/servizi/sposa",
    image: "/images/servizio-sposa.jpg",
    title: "Sposa",
    text: "Acconciatura e make-up, anche a domicilio.",
  },
];

const ticker = ["Taglio", "Colore", "Sposa", "Estetica", "Milano", "Dal 1982"];

const heroSlides = [
  {
    src: "/images/hero.jpg",
    alt: "Acconciatura donna da Tufano Stilisti",
    kicker: "Donna",
    title: "Taglio e colore",
    text: "Look, tinte, balayage ed extension, scelti con te prima di ogni appuntamento.",
    href: "/donna",
    cta: "Scopri Donna",
  },
  {
    src: "/images/g-balayage.jpg",
    alt: "Balayage castano e caramello in salone",
    kicker: "Colore",
    title: "Balayage",
    text: "Schiariture naturali, dal biondo al caramello, su ogni lunghezza.",
    href: "/donna",
    cta: "Vedi i colori",
  },
  {
    src: "/images/g-sposa.jpg",
    alt: "Acconciatura sposa da Tufano Stilisti",
    kicker: "Sposa",
    title: "Il giorno che conta",
    text: "Acconciatura e make-up, in salone oppure a domicilio.",
    href: "/servizi/sposa",
    cta: "Scopri Sposa",
  },
  {
    src: "/images/g-uomo-2.jpg",
    alt: "Hairstyling uomo da Tufano Stilisti",
    kicker: "Uomo",
    title: "Taglio e barba",
    text: "Un taglio classico o di tendenza, con barba e colore.",
    href: "/uomo",
    cta: "Scopri Uomo",
  },
  {
    src: "/images/servizio-estetica.jpg",
    alt: "Trattamento viso da Tufano Stilisti",
    kicker: "Estetica",
    title: "Oltre i capelli",
    text: "Viso, massaggi, mani e piedi, nello stesso salone.",
    href: "/servizi",
    cta: "Vedi i servizi",
  },
];
---

<Layout
  title="Tufano Stilisti | Parrucchiere ed estetica a Milano dal 1982"
  description={description}
  path="/"
  active="home"
>
  <main>
    <section class="hero" aria-roledescription="carousel" aria-label="Immagini del salone">
      <div class="hero-copy">
        {
          heroSlides.map((slide, index) => (
            <div class:list={["hero-panel", index === 0 && "is-active"]} data-panel aria-hidden={index === 0 ? "false" : "true"} inert={index !== 0}>
              <p class="hero-kicker">{slide.kicker}</p>
              {index === 0 ? <h1>{slide.title}</h1> : <h2>{slide.title}</h2>}
              <p class="hero-lead">{slide.text}</p>
              <a href={slide.href} class="btn">{slide.cta}</a>
            </div>
          ))
        }
      </div>
      <div class="hero-visual">
        {
          heroSlides.map((slide, index) => (
            <img
              src={slide.src}
              alt={slide.alt}
              class:list={["hero-slide", index === 0 && "is-active"]}
              data-slide
              aria-hidden={index === 0 ? "false" : "true"}
              fetchpriority={index === 0 ? "high" : "low"}
            />
          ))
        }
        <button type="button" class="hero-arrow hero-prev" data-prev aria-label="Foto precedente"></button>
        <button type="button" class="hero-arrow hero-next" data-next aria-label="Foto successiva"></button>
        <div class="hero-dots">
          {
            heroSlides.map((slide, index) => (
              <button
                type="button"
                class:list={["hero-dot", index === 0 && "is-active"]}
                data-dot={index}
                aria-label={slide.alt}
                aria-current={index === 0 ? "true" : undefined}
              />
            ))
          }
        </div>
      </div>
    </section>

    <script>
      const hero = document.querySelector(".hero");
      const slides = [...document.querySelectorAll("[data-slide]")];
      const panels = [...document.querySelectorAll("[data-panel]")];
      const dots = [...document.querySelectorAll("[data-dot]")];
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let index = 0;
      let timer = 0;

      const show = (next: number) => {
        index = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const active = i === index;
          slide.classList.toggle("is-active", active);
          slide.setAttribute("aria-hidden", String(!active));
        });
        panels.forEach((panel, i) => {
          const active = i === index;
          panel.classList.toggle("is-active", active);
          panel.setAttribute("aria-hidden", String(!active));
          if (active) panel.removeAttribute("inert");
          else panel.setAttribute("inert", "");
        });
        dots.forEach((dot, i) => {
          const active = i === index;
          dot.classList.toggle("is-active", active);
          if (active) dot.setAttribute("aria-current", "true");
          else dot.removeAttribute("aria-current");
        });
      };

      const stop = () => window.clearInterval(timer);
      const start = () => {
        stop();
        if (reduceMotion || slides.length < 2) return;
        timer = window.setInterval(() => show(index + 1), 5600);
      };

      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          show(i);
          start();
        });
      });

      hero?.querySelector("[data-prev]")?.addEventListener("click", () => {
        show(index - 1);
        start();
      });
      hero?.querySelector("[data-next]")?.addEventListener("click", () => {
        show(index + 1);
        start();
      });

      if (hero) {
        hero.addEventListener("mouseenter", stop);
        hero.addEventListener("mouseleave", start);
        hero.addEventListener("focusin", stop);
        hero.addEventListener("focusout", start);
      }

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stop();
        else start();
      });

      start();
    </script>

    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[...ticker, ...ticker].map((item) => <span>{item}</span>)}
      </div>
    </div>

    <section class="story">
      <div data-reveal>
        <p class="kicker">La storia</p>
        <h2>Dal 1982 al tuo servizio</h2>
        <p>
          Tufano Stilisti nasce a Milano da Bruno e Dario. Un salone di famiglia: capelli, estetica e il giorno della sposa, con la stessa cura da più di quarant’anni.
        </p>
        <a href="/chi-siamo" class="text-link">Chi siamo</a>
      </div>
      <img src="/images/servizio-donna.jpg" alt="Colore e taglio donna da Tufano Stilisti" data-reveal />
    </section>

    <section class="pillars">
      {
        pillars.map((item) => (
          <a href={item.href} class="pillar" data-reveal>
            <img src={item.image} alt="" />
            <div>
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </div>
          </a>
        ))
      }
    </section>

    <Hours />

    <section class="preview">
      <div class="preview-head" data-reveal>
        <div>
          <p class="kicker">Foto</p>
          <h2>Dal salone</h2>
        </div>
        <a href="/foto" class="btn btn-line">Apri la galleria</a>
      </div>
      <div class="preview-grid">
        <a href="/foto"><img src="/images/g-balayage.jpg" alt="Balayage da Tufano Stilisti" /></a>
        <a href="/foto"><img src="/images/g-rossi.jpg" alt="Capelli rossi da Tufano Stilisti" /></a>
        <a href="/foto"><img src="/images/g-uomo.jpg" alt="Taglio uomo da Tufano Stilisti" /></a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(300px, 0.86fr) 1.14fr;
    min-height: min(84vh, 820px);
    background: #f7f4ef;
  }

  .hero-visual {
    position: relative;
    min-height: 620px;
    overflow: hidden;
    background: #141414;
  }

  .hero-visual::after {
    content: "";
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    height: 88px;
    background: linear-gradient(transparent, rgba(20, 20, 20, 0.38));
    pointer-events: none;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    opacity: 0;
    transform: scale(1.04);
  }

  .hero-slide.is-active {
    opacity: 1;
    transform: scale(1);
    transition: opacity 1.15s ease, transform 6.4s ease;
    z-index: 1;
  }

  .hero-dots {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 26px;
    display: flex;
    gap: 10px;
    transform: translateX(-50%);
  }

  .hero-dot {
    width: 28px;
    height: 3px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(247, 244, 239, 0.4);
    cursor: pointer;
  }

  .hero-dot.is-active {
    background: #f7f4ef;
  }

  .hero-arrow {
    position: absolute;
    z-index: 3;
    top: 50%;
    width: 46px;
    height: 46px;
    margin-top: -23px;
    border: 1px solid rgba(247, 244, 239, 0.55);
    background: transparent;
    cursor: pointer;
  }

  .hero-arrow::before {
    content: "";
    position: absolute;
    top: 16px;
    width: 10px;
    height: 10px;
    border-top: 1.5px solid #f7f4ef;
    border-right: 1.5px solid #f7f4ef;
  }

  .hero-prev {
    left: 22px;
  }

  .hero-prev::before {
    left: 18px;
    transform: rotate(-135deg);
  }

  .hero-next {
    right: 22px;
  }

  .hero-next::before {
    right: 18px;
    transform: rotate(45deg);
  }

  .hero-arrow:hover {
    background: rgba(247, 244, 239, 0.12);
  }

  .hero-copy {
    position: relative;
    min-height: 460px;
  }

  .hero-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 72px 8vw 72px 6vw;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
  }

  .hero-panel.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .hero-kicker {
    margin: 0 0 14px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 600;
    color: #8c7355;
  }

  .hero-copy h1,
  .hero-copy h2 {
    font-size: clamp(46px, 4.8vw, 78px);
    line-height: 0.92;
    margin: 0 0 16px;
    color: #141414;
  }

  .hero-lead {
    max-width: 420px;
    margin: 0 0 26px;
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.55;
    color: #3d3832;
  }

  .marquee {
    overflow: hidden;
    background: #141414;
    color: #f7f4ef;
    border-top: 1px solid rgba(247, 244, 239, 0.12);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: ticker 28s linear infinite;
  }

  .marquee span {
    padding: 16px 28px;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .marquee span::before {
    content: "·";
    margin-right: 28px;
    color: #c4a574;
  }

  .story {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: 64px;
    align-items: center;
    max-width: 1180px;
    margin: 0 auto;
    padding: 100px 6vw;
  }

  .story::before {
    content: "1982";
    position: absolute;
    top: 36px;
    left: 2vw;
    font-family: "Italiana", serif;
    font-size: clamp(80px, 14vw, 180px);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(20, 20, 20, 0.08);
    pointer-events: none;
  }

  .story h2 {
    font-size: clamp(42px, 5vw, 68px);
    line-height: 0.95;
    margin-bottom: 18px;
  }

  .story p:last-of-type {
    max-width: 460px;
    margin: 0 0 22px;
    line-height: 1.7;
    color: #3d3832;
  }

  .story img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .text-link {
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid #141414;
    padding-bottom: 3px;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    padding: 0 4vw 88px;
  }

  .pillar {
    position: relative;
    display: block;
    min-height: 460px;
    overflow: hidden;
    color: #f7f4ef;
    text-decoration: none;
  }

  .pillar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .pillar:hover img {
    transform: scale(1.04);
  }

  .pillar div {
    position: absolute;
    inset: auto 0 0 0;
    padding: 28px;
    background: linear-gradient(transparent, rgba(20, 20, 20, 0.78));
  }

  .pillar h2 {
    font-size: 42px;
  }

  .pillar p {
    margin: 6px 0 0;
  }

  .preview {
    max-width: 1180px;
    margin: 0 auto;
    padding: 88px 6vw 100px;
  }

  .preview-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 28px;
  }

  .preview h2 {
    font-size: clamp(40px, 5vw, 64px);
  }

  .preview-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr 0.8fr;
    gap: 14px;
  }

  .preview-grid img {
    width: 100%;
    height: 420px;
    object-fit: cover;
  }

  @keyframes ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero-visual {
      min-height: 68vh;
      order: -1;
    }

    .hero-copy {
      min-height: 0;
    }

    .hero-panel {
      position: absolute;
      visibility: hidden;
      padding: 48px 6vw 56px;
    }

    .hero-panel.is-active {
      position: relative;
      visibility: visible;
    }

    .hero-arrow {
      width: 38px;
      height: 38px;
      margin-top: -19px;
    }

    .hero-prev {
      left: 12px;
    }

    .hero-next {
      right: 12px;
    }

    .story,
    .pillars,
    .preview-grid {
      grid-template-columns: 1fr;
    }

    .pillar {
      min-height: 380px;
    }

    .preview-grid img {
      height: 280px;
    }

    .preview-head {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track,
    .pillar img,
    .hero-slide,
    .hero-panel {
      animation: none;
      transition: none;
    }

    .hero-slide,
    .pillar img,
    .hero-panel,
    .hero-panel.is-active {
      transform: none;
    }
  }
</style>
