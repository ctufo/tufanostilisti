---
import Layout from "../layouts/Layout.astro";
import Hours from "../components/Hours.astro";

const description =
  "Tufano Stilisti, parrucchiere ed estetica a Milano dal 1982. Taglio, colore, sposa e trattamenti in Via Giovanni da Milano 1.";

const chapters = [
  {
    href: "/donna",
    image: "/images/p-onde-salone.jpg",
    zoom: 1,
    focus: "center center",
    kicker: "Donna",
    title: "Taglio e colore",
    text: "Look, tinte, balayage ed extension, scelti con te prima di ogni appuntamento.",
    cta: "Scopri Donna",
  },
  {
    href: "/uomo",
    image: "/images/g-uomo.jpg",
    zoom: 1,
    kicker: "Uomo",
    title: "Il taglio",
    text: "Un taglio classico o di tendenza, con colore.",
    cta: "Scopri Uomo",
    flip: true,
  },
  {
    href: "/servizi/sposa",
    image: "/images/p-sposa.jpg",
    zoom: 1,
    focus: "center 30%",
    kicker: "Sposa",
    title: "Il giorno che conta",
    text: "Acconciatura e make-up, in salone oppure a domicilio.",
    cta: "Scopri Sposa",
  },
];

const reel = [
  { src: "/images/p-ritratto.jpg", alt: "Onde caramello da Tufano Stilisti" },
  { src: "/images/p-profilo.jpg", alt: "Balayage biondo in salone" },
  { src: "/images/p-rame.jpg", alt: "Capelli rame da Tufano Stilisti" },
  { src: "/images/p-castano.jpg", alt: "Castano lungo da Tufano Stilisti" },
  { src: "/images/p-lisci.jpg", alt: "Capelli lisci con schiariture da Tufano Stilisti" },
  { src: "/images/p-biondo.jpg", alt: "Onde bionde da Tufano Stilisti" },
  { src: "/images/p-bob.jpg", alt: "Taglio bob biondo da Tufano Stilisti" },
  { src: "/images/p-strada.jpg", alt: "Balayage lungo a Milano" },
  { src: "/images/p-onde-specchi.jpg", alt: "Onde bionde nel salone Tufano" },
  { src: "/images/p-onde-salone.jpg", alt: "Colore caramello da Tufano Stilisti" },
  { src: "/images/p-biondo-strada.jpg", alt: "Biondo medio da Tufano Stilisti" },
  { src: "/images/p-caschetto.jpg", alt: "Caschetto da Tufano Stilisti" },
];

const heroSlides = [
  {
    src: "/images/slide-1.jpg",
    alt: "Taglio donna e uomo da Tufano Stilisti",
    kicker: "Donna e uomo",
    title: "Per lei, per lui",
    text: "Taglio e colore per lei, taglio per lui.",
    href: "/donna",
    cta: "Scopri Donna",
    focus: "center center",
  },
  {
    src: "/images/slide-2b.jpg",
    alt: "Taglio lungo da Tufano Stilisti",
    kicker: "Donna",
    title: "Taglio e colore",
    text: "Look, tinte, balayage ed extension, scelti con te prima di ogni appuntamento.",
    href: "/donna",
    cta: "Scopri Donna",
    focus: "center center",
  },
  {
    src: "/images/slide-3.jpg",
    alt: "Acconciatura sposa con perle da Tufano Stilisti",
    kicker: "Sposa",
    title: "Il giorno che conta",
    text: "Acconciatura e make-up, in salone oppure a domicilio.",
    href: "/servizi/sposa",
    cta: "Scopri Sposa",
    focus: "center center",
  },
];
---

<Layout
  title="Tufano Stilisti | Parrucchiere ed estetica a Milano dal 1982"
  description={description}
  path="/"
  active="home"
>
  <main>
    <section class="hero" aria-roledescription="carousel" aria-label="Immagini del salone">
      <div class="hero-copy">
        {
          heroSlides.map((slide, index) => (
            <div class:list={["hero-panel", index === 0 && "is-active"]} data-panel aria-hidden={index === 0 ? "false" : "true"} inert={index !== 0}>
              <p class="hero-kicker">{slide.kicker}</p>
              {index === 0 ? <h1>{slide.title}</h1> : <h2>{slide.title}</h2>}
              <p class="hero-lead">{slide.text}</p>
              <a href={slide.href} class="btn">{slide.cta}</a>
            </div>
          ))
        }
      </div>
      <div class="hero-visual">
        {
          heroSlides.map((slide, index) => (
            <img
              src={slide.src}
              alt={slide.alt}
              class:list={["hero-slide", index === 0 && "is-active"]}
              data-slide
              aria-hidden={index === 0 ? "false" : "true"}
              fetchpriority={index === 0 ? "high" : "low"}
              style={slide.focus ? `object-position: ${slide.focus}` : undefined}
            />
          ))
        }
        <button type="button" class="hero-arrow hero-prev" data-prev aria-label="Foto precedente"></button>
        <button type="button" class="hero-arrow hero-next" data-next aria-label="Foto successiva"></button>
        <div class="hero-dots">
          {
            heroSlides.map((slide, index) => (
              <button
                type="button"
                class:list={["hero-dot", index === 0 && "is-active"]}
                data-dot={index}
                aria-label={slide.alt}
                aria-current={index === 0 ? "true" : undefined}
              />
            ))
          }
        </div>
      </div>
    </section>

    <script>
      const hero = document.querySelector(".hero");
      const slides = [...document.querySelectorAll("[data-slide]")];
      const panels = [...document.querySelectorAll("[data-panel]")];
      const dots = [...document.querySelectorAll("[data-dot]")];
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let index = 0;
      let timer = 0;

      const show = (next: number) => {
        index = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const active = i === index;
          slide.classList.toggle("is-active", active);
          slide.setAttribute("aria-hidden", String(!active));
        });
        panels.forEach((panel, i) => {
          const active = i === index;
          panel.classList.toggle("is-active", active);
          panel.setAttribute("aria-hidden", String(!active));
          if (active) panel.removeAttribute("inert");
          else panel.setAttribute("inert", "");
        });
        dots.forEach((dot, i) => {
          const active = i === index;
          dot.classList.toggle("is-active", active);
          if (active) dot.setAttribute("aria-current", "true");
          else dot.removeAttribute("aria-current");
        });
      };

      const stop = () => window.clearInterval(timer);
      const start = () => {
        stop();
        if (reduceMotion || slides.length < 2) return;
        timer = window.setInterval(() => show(index + 1), 5600);
      };

      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          show(i);
          start();
        });
      });

      hero?.querySelector("[data-prev]")?.addEventListener("click", () => {
        show(index - 1);
        start();
      });
      hero?.querySelector("[data-next]")?.addEventListener("click", () => {
        show(index + 1);
        start();
      });

      if (hero) {
        hero.addEventListener("mouseenter", stop);
        hero.addEventListener("mouseleave", start);
        hero.addEventListener("focusin", stop);
        hero.addEventListener("focusout", start);
      }

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stop();
        else start();
      });

      start();
    </script>

    <section class="statement" data-reveal>
      <p class="kicker">Milano</p>
      <h2>Dal 1982.</h2>
      <p>
        Tufano Stilisti nasce a Milano da Bruno e Dario. Un salone di famiglia: capelli, estetica e il giorno della sposa.
      </p>
      <a href="/chi-siamo" class="text-link">Chi siamo</a>
    </section>

    {
      chapters.map((item, index) => (
        <a href={item.href} class:list={["chapter", item.flip && "is-flip"]} data-reveal>
          <div class="chapter-copy">
            <p class="kicker">{item.kicker}</p>
            <h2>{item.title}</h2>
            <p class="chapter-lead">{item.text}</p>
            <span class="text-link">{item.cta}</span>
          </div>
          <div class="chapter-visual">
            <img src={item.image} alt="" style={`--zoom: ${item.zoom};${item.focus ? `object-position:${item.focus}` : ""}`} />
            <span class="chapter-index">{String(index + 1).padStart(2, "0")}</span>
          </div>
        </a>
      ))
    }

    <Hours />

    <section class="reel" data-reveal>
      <div class="reel-head">
        <div>
          <p class="kicker">Foto</p>
          <h2>Dal salone</h2>
        </div>
        <a href="/foto" class="text-link">Apri la galleria</a>
      </div>
      <div class="reel-track">
        {
          reel.map((photo) => (
            <a href="/foto">
              <img src={photo.src} alt={photo.alt} />
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(300px, 0.86fr) 1.14fr;
    align-items: stretch;
    background: #f7f4ef;
  }

  .hero-visual {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #141414;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0;
    transform: scale(1.04);
  }

  .hero-slide.is-active {
    opacity: 1;
    transform: scale(1);
    transition: opacity 1.15s ease, transform 8s ease;
    z-index: 1;
  }

  .hero-dots {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 26px;
    display: flex;
    gap: 10px;
    transform: translateX(-50%);
  }

  .hero-dot {
    width: 28px;
    height: 3px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(247, 244, 239, 0.4);
    cursor: pointer;
  }

  .hero-dot {
    position: relative;
    overflow: hidden;
  }

  .hero-dot.is-active {
    width: 42px;
    background: rgba(247, 244, 239, 0.35);
  }

  .hero-dot.is-active::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #f7f4ef;
    transform: scaleX(0);
    transform-origin: left center;
    animation: dot-fill 5.6s linear forwards;
  }

  @keyframes dot-fill {
    to { transform: scaleX(1); }
  }

  .hero-arrow {
    position: absolute;
    z-index: 3;
    top: 50%;
    width: 46px;
    height: 46px;
    margin-top: -23px;
    border: 1px solid rgba(247, 244, 239, 0.55);
    background: transparent;
    cursor: pointer;
  }

  .hero-arrow::before {
    content: "";
    position: absolute;
    top: 16px;
    width: 10px;
    height: 10px;
    border-top: 1.5px solid #f7f4ef;
    border-right: 1.5px solid #f7f4ef;
  }

  .hero-prev {
    left: 22px;
  }

  .hero-prev::before {
    left: 18px;
    transform: rotate(-135deg);
  }

  .hero-next {
    right: 22px;
  }

  .hero-next::before {
    right: 18px;
    transform: rotate(45deg);
  }

  .hero-arrow:hover {
    background: rgba(247, 244, 239, 0.12);
  }

  .hero-copy {
    position: relative;
  }

  .hero-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 72px 8vw 72px 6vw;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
  }

  .hero-panel.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .hero-kicker {
    margin: 0 0 14px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 600;
    color: #8c7355;
  }

  .hero-copy h1,
  .hero-copy h2 {
    font-size: clamp(56px, 5.8vw, 96px);
    line-height: 0.92;
    margin: 0 0 16px;
    color: #141414;
    clip-path: inset(0 0 100% 0);
  }

  .hero-panel.is-active h1,
  .hero-panel.is-active h2 {
    clip-path: inset(0);
    transition: clip-path 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-lead {
    max-width: 420px;
    margin: 0 0 26px;
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.55;
    color: #3d3832;
  }

  .statement {
    padding: 96px 8vw 72px;
    text-align: center;
  }

  section.statement[data-reveal] {
    opacity: 1;
    transform: none;
  }

  .statement h2 {
    font-size: clamp(64px, 10vw, 140px);
    line-height: 0.88;
    margin: 0 0 28px;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .statement.is-in h2 {
    clip-path: inset(0);
  }

  .statement p:last-of-type,
  .statement .text-link {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.7s ease 0.2s, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
  }

  .statement.is-in p:last-of-type,
  .statement.is-in .text-link {
    opacity: 1;
    transform: none;
  }

  .statement p:last-of-type {
    max-width: 460px;
    margin: 0 auto 28px;
    font-size: 18px;
    line-height: 1.6;
    color: #3d3832;
  }

  .text-link {
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
  }

  .chapter {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    min-height: 0;
    background: #f7f4ef;
    color: #141414;
    text-decoration: none;
  }

  .chapter.is-flip {
    background: #141414;
    color: #f7f4ef;
  }

  .chapter.is-flip .chapter-visual {
    order: -1;
  }

  .chapter.is-flip .kicker {
    color: #c4a574;
  }

  .chapter.is-flip .chapter-lead {
    color: rgba(247, 244, 239, 0.78);
  }

  .chapter-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 72px 7vw;
  }

  .chapter h2 {
    font-size: clamp(56px, 6vw, 104px);
    line-height: 0.9;
    margin: 0 0 18px;
  }

  .chapter-lead {
    max-width: 380px;
    margin: 0 0 28px;
    font-size: 18px;
    line-height: 1.55;
    color: #3d3832;
  }

  .chapter-visual {
    position: relative;
    height: min(64vh, 520px);
    max-height: 520px;
    overflow: hidden;
    background: #141414;
  }

  a.chapter[data-reveal] {
    opacity: 1;
    transform: none;
  }

  .chapter-copy {
    opacity: 0;
    transform: translateY(28px);
  }

  .chapter.is-in .chapter-copy {
    opacity: 1;
    transform: none;
    transition: opacity 0.8s ease, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .chapter-visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    transform: scale(calc(var(--zoom, 1) * 1.14));
    transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .chapter.is-in .chapter-visual img {
    transform: scale(var(--zoom, 1));
  }

  .chapter:hover .chapter-visual img {
    transform: scale(calc(var(--zoom, 1) * 1.06));
  }

  .chapter-index {
    position: absolute;
    left: 24px;
    bottom: 22px;
    color: #f7f4ef;
    font-size: 12px;
    letter-spacing: 0.22em;
  }

  .reel {
    padding: 80px 0 72px;
  }

  section.reel[data-reveal] {
    opacity: 1;
    transform: none;
  }

  .reel-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    padding: 0 6vw 28px;
  }

  .reel h2 {
    font-size: clamp(48px, 6vw, 88px);
    margin: 0;
  }

  .reel-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 6vw 8px;
    scrollbar-width: none;
  }

  .reel-track::-webkit-scrollbar {
    display: none;
  }

  .reel-track a {
    flex: 0 0 auto;
    width: min(280px, 70vw);
    height: min(54vh, 460px);
    overflow: hidden;
    scroll-snap-align: start;
    background: #141414;
    opacity: 0;
    transform: translateY(28px);
  }

  .reel.is-in .reel-track a {
    animation: rise 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .reel.is-in .reel-track a:nth-child(2) { animation-delay: 0.06s; }
  .reel.is-in .reel-track a:nth-child(3) { animation-delay: 0.12s; }
  .reel.is-in .reel-track a:nth-child(4) { animation-delay: 0.18s; }
  .reel.is-in .reel-track a:nth-child(5) { animation-delay: 0.24s; }
  .reel.is-in .reel-track a:nth-child(n + 6) { animation-delay: 0.3s; }

  .reel-track img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reel-track a:hover img {
    transform: scale(1.16);
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      height: auto;
      min-height: 0;
      max-height: none;
    }

    .hero-visual {
      aspect-ratio: 3 / 2;
      height: auto;
      order: -1;
    }

    .hero-copy {
      min-height: 0;
    }

    .hero-panel {
      position: absolute;
      visibility: hidden;
      padding: 48px 6vw 56px;
    }

    .hero-panel.is-active {
      position: relative;
      visibility: visible;
    }

    .hero-arrow {
      width: 38px;
      height: 38px;
      margin-top: -19px;
    }

    .hero-prev {
      left: 12px;
    }

    .hero-next {
      right: 12px;
    }

    .statement {
      padding: 88px 6vw 72px;
    }

    .chapter,
    .chapter.is-flip {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .chapter.is-flip .chapter-visual {
      order: -1;
    }

    .chapter-visual {
      height: min(52vh, 420px);
      max-height: 420px;
      order: -1;
    }

    .reel-head {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (scripting: none) {
    .chapter-copy,
    .reel-track a,
    .statement p:last-of-type,
    .statement .text-link {
      opacity: 1;
      transform: none;
    }

    .statement h2,
    .hero-copy h1,
    .hero-copy h2 {
      clip-path: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide,
    .hero-panel,
    .hero-dot.is-active::after,
    .reel-track a,
    .chapter-visual img,
    .statement h2 {
      animation: none;
      transition: none;
    }

    .hero-slide,
    .hero-panel,
    .hero-panel.is-active,
    .chapter-copy,
    .chapter.is-in .chapter-copy,
    .reel-track a,
    .reel.is-in .reel-track a {
      transform: none;
      opacity: 1;
      clip-path: none;
    }

    .hero-copy h1,
    .hero-copy h2,
    .hero-panel.is-active h1,
    .hero-panel.is-active h2,
    .statement h2,
    .statement.is-in h2 {
      clip-path: none;
    }

    .chapter.is-in .chapter-visual img,
    .chapter:hover .chapter-visual img {
      transform: scale(var(--zoom, 1));
    }
  }
</style>
