---
import Layout from "../layouts/Layout.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import { salonPhotos } from "../data/photos";
---

<Layout
  title="Foto | Tufano Stilisti – Parrucchiere Milano"
  description="Foto dei lavori di Tufano Stilisti a Milano: colore, extension, sposa e taglio uomo."
  path="/foto"
  ogImage="/images/g-balayage.jpg"
  active="foto"
>
  <main>
    <section class="intro">
      <p class="kicker">Foto</p>
      <h1>Dal salone</h1>
      <p>Colore, extension, sposa e taglio. Una selezione dei lavori in Via Giovanni da Milano.</p>
    </section>
    <section class="wrap">
      <PhotoGallery photos={salonPhotos} layout="masonry" />
    </section>
  </main>
</Layout>

<style>
  .intro {
    max-width: 760px;
    margin: 0 auto;
    padding: 72px 6vw 12px;
  }

  h1 {
    font-size: clamp(52px, 7vw, 88px);
    line-height: 0.95;
    margin-bottom: 14px;
  }

  .intro p:last-child {
    margin: 0;
    max-width: 460px;
    line-height: 1.7;
    color: #3d3832;
  }

  .wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 36px 4vw 100px;
  }

  @media (max-width: 700px) {
    .intro {
      padding-top: 48px;
    }
  }
</style>
