---
import Layout from "../../layouts/Layout.astro";

const services = [
  {
    title: "Epilazione",
    text: "Per lei e per lui. In salone si prenota con la specialista, anche per i servizi uomo.",
  },
  {
    title: "Mani e piedi",
    text: "Manicure e pedicure, anche mentre sei dal parrucchiere.",
  },
  {
    title: "Semipermanente",
    text: "Smalto semipermanente Shellac, scelto per tenuta e qualità.",
  },
  {
    title: "Massaggi e viso",
    text: "Massaggi, trattamenti viso e radiofrequenza per la pelle.",
  },
  {
    title: "Trucco",
    text: "Make-up per un’occasione, costruito sulla richiesta.",
  },
];
---

<Layout
  title="Servizi | Tufano Stilisti – Estetica a Milano"
  description="Estetica da Tufano Stilisti a Milano: epilazione, mani e piedi, massaggi, trattamenti viso e trucco. Sposa in pagina dedicata."
  path="/servizi"
  ogImage="/images/servizio-estetica.jpg"
  active="servizi"
>
  <main>
    <section class="intro">
      <div>
        <p class="kicker">Servizi</p>
        <h1>Estetica, oltre i capelli</h1>
        <p>
          Il centro estetico è nello stesso salone. Trattamenti, massaggi, manicure e trucco, con un consiglio sul percorso più adatto.
        </p>
      </div>
      <img src="/images/servizio-estetica.jpg" alt="Trattamento viso da Tufano Stilisti" />
    </section>

    <section class="list">
      {
        services.map((item, index) => (
          <article data-reveal>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </section>

    <a class="sposa" href="/servizi/sposa" data-reveal>
      <img src="/images/servizio-sposa.jpg" alt="" />
      <div>
        <p class="kicker light">Servizi</p>
        <h2>Sposa</h2>
        <p>Acconciatura e make-up per il giorno più importante, in salone o a domicilio.</p>
        <span>Apri la pagina</span>
      </div>
    </a>
  </main>
</Layout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 48px;
    align-items: center;
    max-width: 1180px;
    margin: 0 auto;
    padding: 72px 6vw 20px;
  }

  h1,
  .sposa h2 {
    font-size: clamp(48px, 6vw, 80px);
    line-height: 0.95;
  }

  .intro h1 {
    margin-bottom: 16px;
  }

  .intro p:last-of-type {
    max-width: 460px;
    margin: 0;
    line-height: 1.7;
    color: #3d3832;
  }

  .intro img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .list {
    max-width: 980px;
    margin: 0 auto;
    padding: 36px 6vw 20px;
  }

  article {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 16px;
    padding: 28px 0;
    border-top: 1px solid rgba(20, 20, 20, 0.12);
  }

  article span,
  .sposa > div > span {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8c7355;
  }

  article h2 {
    font-size: clamp(28px, 3vw, 40px);
    margin-bottom: 8px;
  }

  article p {
    margin: 0;
    max-width: 560px;
    line-height: 1.65;
    color: #3d3832;
  }

  .sposa {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: 36px;
    align-items: center;
    max-width: 1180px;
    margin: 28px auto 100px;
    padding: 0 6vw;
    color: inherit;
    text-decoration: none;
  }

  .sposa img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .kicker.light {
    color: #8c7355;
  }

  .sposa p:last-of-type {
    max-width: 420px;
    margin: 12px 0 18px;
    line-height: 1.7;
  }

  @media (max-width: 800px) {
    .intro,
    .sposa,
    article {
      grid-template-columns: 1fr;
    }

    .intro {
      padding-top: 48px;
    }

    .sposa {
      margin-bottom: 72px;
    }
  }
</style>
